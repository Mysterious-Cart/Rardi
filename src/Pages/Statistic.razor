@page "/statistic"
@using CHKS.Services
@attribute [Authorize(Roles = "Admin,Dev")]

<PageTitle>Statistic</PageTitle>

@if (PerformancePoints is null || RecentTransactions is null)
{
    <RadzenStack JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Style="height:100vh;">
        <RadzenProgressBar Mode="@ProgressBarMode.Indeterminate" Style="width: 200px;" />
    </RadzenStack>
}
else
{
    
<RadzenStack Orientation="Orientation.Vertical" Gap="16px" Style="padding: 24px; max-height: 100vh; ">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
        JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="12px">
        <RadzenStack Orientation="Orientation.Vertical" Gap="4px">
            <RadzenText Text="Statistics" Style="font-size: 24px; font-weight: 700;" />
            <RadzenText Text="POS performance overview" Style="color: #6c757d;" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px" Wrap="FlexWrap.Wrap">
            <RadzenButton Text="Today" Click="@(() => ApplyQuickRangeAsync(1))" ButtonStyle="ButtonStyle.Light" />
            <RadzenButton Text="7d" Click="@(() => ApplyQuickRangeAsync(7))" ButtonStyle="ButtonStyle.Light" />
            <RadzenButton Text="30d" Click="@(() => ApplyQuickRangeAsync(30))" ButtonStyle="ButtonStyle.Light" />

            <RadzenLabel Text="From" />
            <RadzenDatePicker @bind-Value="@TimeStart" Name="From" DateFormat="dd/MM/yyyy" Max="@DateTime.Now" />
            <RadzenLabel Text="To" />
            <RadzenDatePicker @bind-Value="@TimeEnd" Name="To" DateFormat="dd/MM/yyyy" Max="@DateTime.Now" />
            <RadzenButton Text="Refresh" Icon="refresh" Click="@RefreshPage" ButtonStyle="ButtonStyle.Primary" />
        </RadzenStack>
    </RadzenStack>
    <RadzenStack style="overflow-y: auto; flex-grow: 1;" Gap="16px">
        <RadzenRow>
            <RadzenColumn Size="3" >
                <RadzenCard Style="height: 140px; background: #0d6efd10; border: 1px solid #0d6efd20;">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="6px">
                        <RadzenText Text="Profit" Style="font-weight:600; color:#0d6efd;" />
                        <RadzenText Text="@FormatCurrency(NetProfit)" Style="font-size:28px; font-weight:700;" />
                        <RadzenText Text="After expenses" Style="color:#6c757d;" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenCard Style="height: 140px;">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="6px">
                        <RadzenText Text="Revenue" Style="font-weight:600; color:#198754;" />
                        <RadzenText Text="@FormatCurrency(RevenueTotal)" Style="font-size:28px; font-weight:700;" />
                        <RadzenText Text="Sales + services" Style="color:#6c757d;" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenCard Style="height: 140px;">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="6px">
                        <RadzenText Text="COGS" Style="font-weight:600; color:#dc3545;" />
                        <RadzenText Text="@FormatCurrency(CogsTotal)" Style="font-size:28px; font-weight:700;" />
                        <RadzenText Text="Inventory cost" Style="color:#6c757d;" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenCard Style="height: 140px;">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="6px">
                        <RadzenText Text="Gross Margin" Style="font-weight:600; color:#fd7e14;" />
                        <RadzenText Text="@($"{GrossMarginPercent:N2}%")" Style="font-size:28px; font-weight:700;" />
                        <RadzenText Text="(Revenue - COGS) / Revenue" Style="color:#6c757d;" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow >
            <RadzenColumn Size="8">
                <RadzenCard Style="height: 360px;">
                    <RadzenText Text="Revenue vs COGS" Style="font-weight:600; margin-bottom:8px; display:block;" />
                    <RadzenChart Style="height: 300px;" ColorScheme="ColorScheme.Pastel">
                        <RadzenAreaSeries Title="Revenue" TItem="TransactionPerformancePoint" ValueProperty="@(nameof(TransactionPerformancePoint.Revenue))"
                            CategoryProperty="@(nameof(TransactionPerformancePoint.Date))" Data="@PerformancePoints" LineType="LineType.Solid" />
                        <RadzenLineSeries Title="COGS" TItem="TransactionPerformancePoint" ValueProperty="@(nameof(TransactionPerformancePoint.Cogs))"
                            CategoryProperty="@(nameof(TransactionPerformancePoint.Date))" Data="@PerformancePoints" LineType="LineType.Dotted" />
                        <RadzenValueAxis  FormatString="${0:N0}" >
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                        <RadzenCategoryAxis Formatter="@(date => ((DateTime)date).ToString("dd MMM"))" />
                    </RadzenChart>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenCard Style="height: 360px;">
                    <RadzenText Text="Payment mix" Style="font-weight:600; margin-bottom:8px; display:block;" />
                    <RadzenChart Style="height: 300px;">
                        <RadzenPieSeries TItem="PaymentSlice"
                            CategoryProperty="Label" ValueProperty="Value" Radius="0.9"
                        />
                    </RadzenChart>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow >
            <RadzenColumn Size="8">
                <RadzenCard Style="height: 360px;">
                    <RadzenText Text="Profit & Gross Margin" Style="font-weight:600; margin-bottom:8px; display:block;" />
                    <RadzenChart Style="height: 300px;"   >
                        <RadzenColumnSeries TItem="TransactionPerformancePoint" Title="Profit" ValueProperty="Profit"
                            CategoryProperty="Date" Data="@PerformancePoints"/>
                        <RadzenLineSeries TItem="TransactionPerformancePoint" Title="Gross Margin %"
                            ValueProperty="GrossMarginPercent" CategoryProperty="Date" LineType="LineType.Solid"
                            />
                        <RadzenValueAxis FormatString="${0:N0}" />
                        <RadzenValueAxis FormatString="{0}%" Min="0" Max="100" />
                        <RadzenCategoryAxis FormatString="dd MMM" />
                    </RadzenChart>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenCard Style="height: 360px;">
                    <RadzenText Text="Income breakdown" Style="font-weight:600; margin-bottom:8px; display:block;" />
                    <RadzenStack Orientation="Orientation.Vertical" Gap="8px">
                        <RadzenRow JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenText Text="Bank" />
                            <RadzenText Text="@FormatCurrency(ReportData?.Income.Bank)" />
                        </RadzenRow>
                        <RadzenRow JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenText Text="USD" />
                            <RadzenText Text="@FormatCurrency(ReportData?.Income.Dollar)" />
                        </RadzenRow>
                        <RadzenRow JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenText Text="THB" />
                            <RadzenText Text="@FormatCurrency(ReportData?.Income.Baht)" />
                        </RadzenRow>
                        <RadzenRow JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenText Text="KHR" />
                            <RadzenText Text="@FormatCurrency(ReportData?.Income.Riel)" />
                        </RadzenRow>
                        <RadzenRow JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenText Text="Expenses" Style="color:#dc3545;" />
                            <RadzenText Text="@FormatCurrency(ReportData?.Expense)" Style="color:#dc3545;" />
                        </RadzenRow>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <RadzenCard>
            <RadzenText Text="Past Transactions" Style="font-weight:600; margin-bottom:8px; display:block;" />
            <RadzenDataGrid Data="@RecentTransactions" TItem="History" AllowPaging="true" AllowSorting="true"
                AllowFiltering="true" AllowVirtualization="true" PageSize="20" Style="height: 420px;"
                RowSelect="@OpenHistory" GridLines="Radzen.DataGridGridLines.Horizontal">
                <Columns>
                    <RadzenDataGridColumn TItem="History" Property="PaidAt" Title="Date" FormatString="{0:dd/MM/yyyy}" />
                    <RadzenDataGridColumn TItem="History" Property="Plate" Title="Plate" />
                    <RadzenDataGridColumn TItem="History" Property="User" Title="User" />
                    <RadzenDataGridColumn TItem="History" Property="Total" Title="Total" FormatString="$ {0:N2}" />
                    <RadzenDataGridColumn TItem="History" Title="Payment">
                        <Template Context="data">@PaymentMethodLabel(data)</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    </RadzenStack>
</RadzenStack>

}