@page "/"
@using System.Globalization
@attribute [Authorize]

<PageTitle>Cashier</PageTitle>

<RadzenStack Gap="1rem" class="page-shell">
    <RadzenCard class="panel accent">
        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <div>
                <RadzenText class="headline">Cashier POS</RadzenText>
                <RadzenText class="subtext">បង្កើតរទេះ • បញ្ចូលទំនិញ • គិតលុយ</RadzenText>
            </div>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <RadzenButton Icon="person_add" Text="អតិថជនថ្មី" ButtonStyle="ButtonStyle.Primary" Click="@CreateCustomer" />
                <RadzenToggleButton OnText="បង្ហាញប្រាក់ថ្មី" OffText="បិទ" ToggleIcon="check" Value="@showRecentCashout" Change="@(args => ToggleRecentCashout())" />
            </RadzenStack>
        </RadzenRow>
        <RadzenTextBox Placeholder="ស្វែងរកទំនិញ / បាកូដ" Style="width:100%; margin-top:0.5rem" @onchange="@(args => Search(args))" />
    </RadzenCard>

    <RadzenRow>
        <RadzenColumn Size="3" Medium="4" Large="4">
            <RadzenCard class="panel">
                <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText class="section-title">អតិថជនកំពុងទិញ</RadzenText>
                    <RadzenButton Icon="add" Text="បង្កើតថ្មី" ButtonStyle="ButtonStyle.Light" Click="@CreateCustomer" />
                </RadzenRow>
                <RadzenStack Gap="0.75rem" Style="max-height:50vh; overflow:auto; margin-top:0.5rem;">
                    @if (Carts != null)
                    {
                        @foreach (var customer in Carts)
                        {
                            <RadzenCard class="card customer-card" @onclick="@(args => OpenCart(customer))">
                                <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                    <RadzenText class="card-title">@(customer.Plate + " #" + customer.CartId)</RadzenText>
                                </RadzenRow>
                                <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                    <RadzenText class="muted">@customer.Creator</RadzenText>
                                    <RadzenText class="muted">@customer.Car?.Type</RadzenText>
                                </RadzenRow>
                            </RadzenCard>
                        }
                    }
                    else
                    {
                        <RadzenText class="muted">គ្មានអតិថជនកំពុងទិញ</RadzenText>
                    }
                </RadzenStack>

                <RadzenPanel Text="បង់ប្រាក់ថ្មីៗ" AllowCollapse=true Expanded="@showRecentCashout"  Style="margin-top:1rem;">
                    <RadzenStack Gap="0.5rem" Style="max-height:40vh; overflow:auto;">
                        @if (RecentHistory != null)
                        {
                            @foreach (var history in RecentHistory)
                            {
                                <RadzenCard class="card paid-card" @onclick="@(args => OpenCart(history))">
                                    <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                        <RadzenText class="card-title">@history.Plate</RadzenText>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                        <RadzenText class="muted">@history.User</RadzenText>
                                        <RadzenText class="muted">@history.CashoutDate</RadzenText>
                                    </RadzenRow>
                                </RadzenCard>
                            }
                        }
                        else
                        {
                            <RadzenText class="muted">គ្មានប្រវត្តិ</RadzenText>
                        }
                    </RadzenStack>
                </RadzenPanel>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="5" Medium="5" Large="5">
            <RadzenCard class="panel">
                <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText class="section-title">បញ្ជីទំនិញ</RadzenText>
                    <RadzenButton Icon="add_box" Text="បន្ថែមទំនិញ" ButtonStyle="ButtonStyle.Light" Click="@CreateNewProduct" />
                </RadzenRow>
                <div class="product-grid">
                    @if (Inventories.Any())
                    {
                        @foreach (var product in Inventories)
                        {
                            var stockColor = product.Stock == 0 ? "#ef4444" : product.Stock <= 3 ? "#eab308" : "#16a34a";
                            <RadzenCard class="card product-card" @onclick="@(args => AddItemtoCart(product))">
                                <div class="stock-bar" style="background-color:@stockColor; width:100%"></div>
                                <RadzenText class="card-title">@product.Name</RadzenText>
                                <RadzenText class="muted">បាកូដ: @product.Barcode</RadzenText>
                                <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                    <RadzenText class="price">$@Math.Round(product.Export.GetValueOrDefault(), 2)</RadzenText>
                                </RadzenRow>
                            </RadzenCard>
                        }
                    }
                    else
                    {
                        <div class="empty-state">គ្មានទំនិញ</div>
                    }
                </div>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="4" Medium="3" Large="3">
            <RadzenCard class="panel cart-panel">
                <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenStack>
                        <RadzenText class="section-title">@((Customer.Plate != null ? Customer.Plate : "អតិថជនថ្មី"))</RadzenText>
                        <RadzenText class="muted">កូដ: @(Customer.CartId == 0 ? "***" : Customer.CartId)</RadzenText>
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                        <RadzenButton Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@ResetToDefault" />
                        @if (Customer.CartId != -1 && Customer.CartId != 0)
                        {
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="@DeleteCustomer" />
                        }
                    </RadzenStack>
                </RadzenRow>

                <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Style="margin-top:0.5rem;">
                    <RadzenText class="muted">@Customer.Creator</RadzenText>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                        <RadzenText class="muted">ឡានក្រុមហ៊ុម</RadzenText>
                        <RadzenIcon id="ToggleBar" class="@ToggleButtonClass" @onclick="@Togglebutton" Icon="@ToggleIcon" />
                    </RadzenStack>
                </RadzenRow>

                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" Style="margin-top:1rem; max-height:50vh; overflow:auto;">
                    @if (Customer.Plate != null)
                    {
                        if (Connectors != null)
                        {
                            @foreach (var item in Connectors)
                            {
                                <div class="cart-line" @onclick="@(args => EditProduct(item))">
                                    <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                        <RadzenText class="card-title">@item.Inventory.Name</RadzenText>
                                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Light" class="icon-ghost" @onclick:stopPropagation="true" Click="@(args => ChangeQty(item, 2))" />
                                    </RadzenRow>
                                    <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.15rem">
                                            <RadzenButton Icon="remove" ButtonStyle="ButtonStyle.Light" class="qty-btn" @onclick:stopPropagation="true" Click="@(args => ChangeQty(item, -1))" />
                                            <div class="qty-chip">@Math.Round(item.Qty).ToString()</div>
                                            <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Light" class="qty-btn" @onclick:stopPropagation="true" Click="@(args => ChangeQty(item, 1))" />
                                        </RadzenStack>
                                        <div class="price-pill">$@Math.Round(item.PriceOverwrite.GetValueOrDefault(), 2)</div>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                        <RadzenText class="muted">@item.Note</RadzenText>
                                    </RadzenRow>
                                </div>
                            }
                        }
                        if (Historyconnectors != null)
                        {
                            @foreach (var item in Historyconnectors)
                            {
                                <div class="cart-line" @onclick="@(args => EditProduct(item))">
                                    <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                        <RadzenText class="card-title">@item.Product</RadzenText>
                                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Light" class="icon-ghost" @onclick:stopPropagation="true" Click="@(args => ChangeQty(item, 2))" />
                                    </RadzenRow>
                                    <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.15rem">
                                            <RadzenButton Icon="remove" ButtonStyle="ButtonStyle.Light" class="qty-btn" @onclick:stopPropagation="true" Click="@(args => ChangeQty(item, -1))" />
                                            <div class="qty-chip">@Math.Round(item.Qty.GetValueOrDefault()).ToString()</div>
                                            <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Light" class="qty-btn" @onclick:stopPropagation="true" Click="@(args => ChangeQty(item, 1))" />
                                        </RadzenStack>
                                        <div class="price-pill">$@Math.Round(item.Export.GetValueOrDefault(), 2)</div>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                        <RadzenText class="muted">@item.Note</RadzenText>
                                    </RadzenRow>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <div class="empty-state">ជ្រើសរើសអតិថជនដើម្បីចាប់ផ្តើម</div>
                    }
                </RadzenStack>

                <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Style="margin-top:1rem;">
                    <RadzenText class="section-title">Total</RadzenText>
                    <RadzenText class="total">@(Connectors != null && Connectors.Any() ?
                        Connectors.Sum(i => (i.PriceOverwrite * i.Qty).GetValueOrDefault()).ToString("c", new CultureInfo("us-US")) :
                        Historyconnectors != null && Historyconnectors.Any() ?
                        Math.Round(Historyconnectors.Sum(i => i.Export * i.Qty).GetValueOrDefault(), 2).ToString("c", new CultureInfo("us-US")) : "$ 0.00")
                    </RadzenText>
                </RadzenRow>

                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" Style="margin-top:0.5rem;">
                    <RadzenButton Icon="print" Text="បោះពុម្ព" ButtonStyle="ButtonStyle.Light" Click="@PrintReceipt" Disabled="@(Customer.Plate == null)" />
                    @if (Customer.CartId != -1 && Customer.CartId != 0)
                    {
                        <RadzenButton Icon="attach_money" Text="គិតលុយ" ButtonStyle="ButtonStyle.Success" Click="@CashOut" />
                    }
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>

<div id="snackbar" class="@ToastState">
    @ToastString
</div>

<style>
    
    .page-shell { padding: 1.5rem; }
    .panel { border-radius: 14px; box-shadow: 0 8px 20px rgba(0,0,0,0.05); border: 1px solid #e2e8f0; }
    .accent { background: linear-gradient(135deg,#0ea5e9,#2563eb); color: white; }
    .accent .headline { color: white; }
    .headline { font-family: 'Khmer OS Battambang'; font-size: 1.6rem; font-weight: 700; color: #0f172a; }
    .subtext { font-family: 'Khmer OS Battambang'; color: #e2e8f0; display:block; }
    .section-title { font-family: 'Khmer OS Battambang'; font-size: 1.2rem; font-weight: 700; color: #0f172a; }
    .card-title { font-family: 'Khmer OS Battambang'; font-size: 1.1rem; font-weight: 700; color: #111827; }
    .muted { font-family: 'Khmer OS Battambang'; color: #6b7280; font-size: 0.95rem; }
    .price { font-family: 'Khmer OS Battambang'; font-size: 1.05rem; font-weight: 700; color: #0f172a; }
    .total { font-family: 'Khmer OS Battambang'; font-size: 1.3rem; font-weight: 700; color: #111827; }
    .card { border: 1px solid #e5e7eb; border-radius: 12px; cursor: pointer; }
    .card:hover { box-shadow: 0 8px 16px rgba(0,0,0,0.08); }
    .customer-card { background:#f8fafc; }
    .paid-card { background:#f0fdf4; }
    .product-card { background:white; }
    .product-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(220px,1fr)); gap: 0.75rem; margin-top: 0.75rem; max-height: 70vh; overflow:auto; }
    .stock-bar { height: 6px; border-radius: 8px; margin-bottom: 8px; }
    .empty-state { font-family: 'Khmer OS Battambang'; color:#94a3b8; padding:1rem; text-align:center; }
    .cart-panel { background:#f8fafc; }
    .cart-line { border:1px solid #e2e8f0; border-radius:10px; padding:0.5rem 0.75rem; background:white; }
    .qty-chip { min-width:32px; height:32px; border-radius:16px; background:#f1f5f9; display:flex; align-items:center; justify-content:center; font-weight:700; color:#0f172a; }
    .qty-btn { width:28px; height:28px; border-radius:8px; padding:0; }
    .icon-ghost { width:28px; height:28px; border-radius:8px; padding:0; }
    .price-pill { background:#0ea5e9; color:white; padding:6px 12px; border-radius:12px; font-family:'Khmer OS Battambang'; font-weight:700; letter-spacing:0.2px; }
    #snackbar { visibility: hidden; min-width: 120px; background-color: #111827; color: #fff; text-align: center; border-radius: 6px; padding: 10px; position: fixed; z-index: 10; right: 20px; bottom: 30px; font-family: 'Khmer OS Battambang'; }
    #snackbar.show { visibility: visible; animation: fadein 0.3s, fadeout 0.3s 1.4s; }
    @@keyframes fadein { from { bottom: 0; opacity: 0; } to { bottom: 30px; opacity: 1; } }
    @@keyframes fadeout { from { bottom: 30px; opacity: 1; } to { bottom: 0; opacity: 0; } }
</style>

